# ---- Main site ----
# Requires A records for @ and www. If you only created the `api` record,
# delete this block or Caddy will retry cert issuance for it forever.
iibb.com.tr, www.iibb.com.tr {
	root * /var/www/iibb
	encode zstd gzip
	file_server

	try_files {path} {path}/index.html {path}.html /index.html

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/site.log
	}
}

# ---- API subdomain ----
api.iibb.com.tr {
	encode zstd gzip

	# https://api.<domain>/ckys-backend/route_permit/verify/<any-uuid>/  -> index.html
	# The trailing * swallows the UUID and the trailing slash, so every
	# verification link resolves to the same file.
	handle /ckys-backend/route_permit/verify/* {
		root * /var/www/ozbeklerhafriyat
		rewrite * /index.html
		file_server

		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
		}
	}

	# Everything else on the subdomain goes to the backend.
	# Drop this block if you have no backend yet.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	log {
		output file /var/log/caddy/api.log
	}
}
